# ローカル開発用の環境変数の見本です。
# このファイルをコピーして「.env」という名前のファイルを作り、値を書き込んでください。
# .env は .gitignore で除外されているので、GitHub には上がりません。
# 本番（Vercel）では、Vercel の設定画面で同じ名前の環境変数を登録します。

# Anthropic Console（console.anthropic.com）で作った APIキー
ANTHROPIC_API_KEY=

# 使うモデル。まずは軽量な Haiku で品質を確かめる
ANTHROPIC_MODEL=claude-haiku-5-5

# AI提案のデモコード。自分で決める。これを知っている人だけがAI提案を使える（未設定だと誰も使えない）
# 同期コード（SYNC_CODE）を入れた自分の端末は、デモコードなしで使える
DEMO_CODE=

# 自分専用の同期（Upstash のデータベース画面の「REST API」欄からコピー）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 同期の合言葉。自分で決める（15文字以上の推測されにくいもの）。PCとスマホで同じものを入れる
SYNC_CODE=
